@article{bundela_integration_2026,
  title = {Integration Frameworks for Harmonizing {{CRM}} and {{ERP}} in Real-Time Revenue Operations},
  author = {Bundela, Ansha},
  date = {2026-07-31},
  journaltitle = {World Journal of Advanced Engineering Technology and Sciences},
  shortjournal = {World J. Adv. Eng. Technol. Sci.},
  volume = {20},
