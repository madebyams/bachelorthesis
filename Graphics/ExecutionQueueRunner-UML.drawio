        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class ExecutionQueueRunner {\n    -AutomationEventBuffer automationBuffer\n    -CoAPMCUConnection mcuConnection\n    +ExecutionQueueRunner(AutomationEventBuffer automationBuffer)\n    +run(executionQueue: ExecutionQueue): Unit\n    +run(executionQueue: java.util.List~Executable~): Unit\n    -execute(executable: Executable): MCUResponse\n    -executeSingleExecutable(executable: SingleExecutable): MCUResponse\n    -executeGroup(group: ExecutableGroup, predicate: Function): MCUResponse\n  }\n\n  class AutomationEventBuffer {\n    +add(id, response, startTime, endTime): Unit\n  }\n\n  class CoAPMCUConnection {\n    +run(executable: SingleExecutable): MCUResponse\n  }\n\n  class ExecutionQueue {\n    +iterator(): Iterator~Executable~\n  }\n\n  class Executable {\n    &lt;&lt;interface&gt;&gt;\n    +getId()\n  }\n\n  class SingleExecutable {\n    &lt;&lt;class&gt;&gt;\n  }\n\n  class ExecutableGroup {\n    &lt;&lt;abstract&gt;&gt;\n    +group: List~List~Executable~~\n  }\n\n  class XORGroup {\n    &lt;&lt;class&gt;&gt;\n  }\n\n  class ORGroup {\n    &lt;&lt;class&gt;&gt;\n  }\n\n  class ANDGroup {\n    &lt;&lt;class&gt;&gt;\n  }\n\n  class MCUResponse {\n    +result()\n  }\n\n  class BooleanValue {\n    &lt;&lt;case class&gt;&gt;\n    +value: Boolean\n  }\n\n  class IntValue {\n    &lt;&lt;case class&gt;&gt;\n    +value: Int\n  }\n\n  ExecutionQueueRunner --&gt; AutomationEventBuffer : uses\n  ExecutionQueueRunner *-- CoAPMCUConnection : creates\n  ExecutionQueueRunner --&gt; ExecutionQueue : processes\n  ExecutionQueueRunner --&gt; Executable : executes\n  ExecutionQueueRunner --&gt; MCUResponse : returns\n  ExecutionQueueRunner --&gt; BooleanValue : evaluates\n  ExecutionQueueRunner --&gt; IntValue : evaluates\n\n  SingleExecutable ..|&gt; Executable\n  ExecutableGroup ..|&gt; Executable\n  XORGroup --|&gt; ExecutableGroup\n  ORGroup --|&gt; ExecutableGroup\n  ANDGroup --|&gt; ExecutableGroup\n\n  CoAPMCUConnection --&gt; SingleExecutable : runs\n  CoAPMCUConnection --&gt; MCUResponse : returns\n  ExecutionQueue o-- Executable : contains\n  ExecutableGroup o-- Executable : groups\n  MCUResponse --&gt; BooleanValue : result\n  MCUResponse --&gt; IntValue : result&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ylywe6VYnycyGWeja3BJ-1">
